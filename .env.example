PORT=8090

# Idioma para Tesseract CLI cuando está instalado en el servidor/contenedor
TESSERACT_LANG=spa

# Opcional: si se configura GEMINI_API_KEY, el servicio puede usar visión multimodal como respaldo
GEMINI_API_KEY=
